# Frontend config
REACT_APP_API_BASE=http://localhost:8787
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_LOG_LEVEL=info

# Enable UI features for development
REACT_APP_FEATURE_FLAGS={"voice_input":true,"voice_output":true,"auto_tts":false,"attachments_backend":false,"reactions_enabled":true}

# Optional
REACT_APP_EXPERIMENTS_ENABLED=false
